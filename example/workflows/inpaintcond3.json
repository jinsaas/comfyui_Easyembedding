e":"prompt_text","name":"prompt_text","type":"STRING","widget":{"name":"prompt_text"},"link":null},{"label":"output_settings","localized_name":"output_settings","name":"output_settings","type":"COMBO","widget":{"name":"output_settings"},"link":null},{"label":"file_name","localized_name":"file_name","name":"file_name","type":"STRING","widget":{"name":"file_name"},"link":null},{"label":"emb_opt","localized_name":"emb_opt","name":"emb_opt","type":"COMBO","widget":{"name":"emb_opt"},"link":null}],"outputs":[{"label":"conditioning","localized_name":"conditioning","name":"conditioning","type":"CONDITIONING","links":[941]}],"properties":{"Node name for S&R":"EasyClipTextEncodeSimple"},"widgets_values":["best quality","conditioning","easyemb_%number","basic"],"widgets_values_named":{"prompt_text":"best quality","output_settings":"conditioning","file_name":"easyemb_%number","emb_opt":"basic"}},{"id":399,"type":"EasyClipTextEncodeSimple","pos":[-3075.1840001082373,-2429.744564133537],"size":[746.1875,253.984375],"flags":{},"order":16,"mode":0,"inputs":[{"label":"clip","localized_name":"clip","name":"clip","type":"CLIP","link":846},{"label":"prompt_text","localized_name":"prompt_text","name":"prompt_text","type":"STRING","widget":{"name":"prompt_text"},"link":null},{"label":"output_settings","localized_name":"output_settings","name":"output_settings","type":"COMBO","widget":{"name":"output_settings"},"link":null},{"label":"file_name","localized_name":"file_name","name":"file_name","type":"STRING","widget":{"name":"file_name"},"link":null},{"label":"emb_opt","localized_name":"emb_opt","name":"emb_opt","type":"COMBO","widget":{"name":"emb_opt"},"link":null}],"outputs":[{"label":"conditioning","localized_name":"conditioning","name":"conditioning","type":"CONDITIONING","links":[942]}],"properties":{"Node name for S&R":"EasyClipTextEncodeSimple"},"widgets_values":["worst quality","conditioning","easyemb_%number","basic"],"widgets_values_named":{"prompt_text":"worst quality","output_settings":"conditioning","file_name":"easyemb_%number","emb_opt":"basic"}},{"id":453,"type":"IRL_ColorTransfer","pos":[-2572.1286779572247,-2005.6390401937167],"size":[225,78],"flags":{},"order":17,"mode":0,"inputs":[{"label":"image","localized_name":"image","name":"image","type":"IMAGE","link":1005},{"label":"samp_image","localized_name":"samp_image","name":"samp_image","type":"IMAGE","link":965}],"outputs":[{"label":"image","localized_name":"image","name":"image","type":"IMAGE","links":[967]}],"properties":{"Node name for S&R":"IRL_ColorTransfer"}},{"id":412,"type":"Note","pos":[-3076.613367887132,-1833.8104549438542],"size":[1056.5,775],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["만약 인페인트 노드의 시작 퍼센티지/ 끝 퍼센티지를 0,1로 둔 상태라면 별개의 프롬프트를 둘 필요는 없습니다. 인페인트 노드에서 바로 샘플러로 연결하세요.\n라텐트 가이드 설정에 따라 각기 다른 회색조로 덮인 라텐트의 방식으로 라텐트가 전달됩니다.\n샘플 팔레트는 합성영역을 어느정도 맞춘 이미지를 받아 전달하는 방식이며, 선택 모드에 따라 라텐트를 전달하는 기준점이 달라집니다.\n(대상의 위치 지정이 유사해야 붕괴가 줄어듭니다.최소한 마스크 영역에 해당하는 부분은 어느정도 위치가 일치해야 합니다.)\n\n이 구획에 사용된 클립 프롬프트들은 클립인코더의 레이어 정보도 어느정도 가져와 훅에 전달하므로 이 프롬프트가 연결된 경우와 연결 안된 경우의 레이어 매칭은 결과가 달라질 수 있습니다.(이 노드팩에 있는 모든 텍스트 프롬프트는 전부 이 기능이 포함되어 있습니다.)\n\nIf the start and end percentages of the inpaint node are set to 0 and 1, there is no need to add a separate prompt. You can connect the inpaint node directly to the sampler.\nDepending on the latent guide settings, the latent is delivered in different shades of gray.\nThe sample palette processes images whose composite areas are roughly aligned, and the reference point for latent delivery changes depending on the selected mode.\n(Similar target positioning helps reduce artifacts; at least the parts corresponding to the masked area should be roughly aligned.)\nThe CLIP prompts used in this section also extract some layer information from the CLIP encoder and pass it to the hook. Therefore, the results of layer matching may differ depending on whether the prompt is linked. (All text prompts in this node pack include this feature.)"],"widgets_values_named":{"text":"만약 인페인트 노드의 시작 퍼센티지/ 끝 퍼센티지를 0,1로 둔 상태라면 별개의 프롬프트를 둘 필요는 없습니다. 인페인트 노드에서 바로 샘플러로 연결하세요.\n라텐트 가이드 설정에 따라 각기 다른 회색조로 덮인 라텐트의 방식으로 라텐트가 전달됩니다.\n샘플 팔레트는 합성영역을 어느정도 맞춘 이미지를 받아 전달하는 방식이며, 선택 모드에 따라 라텐트를 전달하는 기준점이 달라집니다.\n(대상의 위치 지정이 유사해야 붕괴가 줄어듭니다.최소한 마스크 영역에 해당하는 부분은 어느정도 위치가 일치해야 합니다.)\n\n이 구획에 사용된 클립 프롬프트들은 클립인코더의 레이어 정보도 어느정도 가져와 훅에 전달하므로 이 프롬프트가 연결된 경우와 연결 안된 경우의 레이어 매칭은 결과가 달라질 수 있습니다.(이 노드팩에 있는 모든 텍스트 프롬프트는 전부 이 기능이 포함되어 있습니다.)\n\nIf the start and end percentages of the inpaint node are set to 0 and 1, there is no need to add a separate prompt. You can connect the inpaint node directly to the sampler.\nDepending on the latent guide settings, the latent is delivered in different shades of gray.\nThe sample palette processes images whose composite areas are roughly aligned, and the reference point for latent delivery changes depending on the selected mode.\n(Similar target positioning helps reduce artifacts; at least the parts corresponding to the masked area should be roughly aligned.)\nThe CLIP prompts used in this section also extract some layer information from the CLIP encoder and pass it to the hook. Therefore, the results of layer matching may differ depending on whether the prompt is linked. (All text prompts in this node pack include this feature.)"},"color":"#432","bgcolor":"#653"},{"id":460,"type":"Note","pos":[-4366.544799062881,-1579.228174862053],"size":[402.375,217.625],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["작업 대상 이미지를 불러옵니다.\n\nLoad the target image."],"widgets_values_named":{"text":"작업 대상 이미지를 불러옵니다.\n\nLoad the target image."},"color":"#432","bgcolor":"#653"},{"id":74,"type":"VAEDecode","pos":[-868.3233904616056,-2373.6417285860307],"size":[225,71.5625],"flags":{},"order":24,"mode":0,"inputs":[{"label":"레이턴트","localized_name":"잠재 데이터","name":"samples","type":"LATENT","link":682},{"label":"VAE","localized_name":"vae","name":"vae","type":"VAE","link":7